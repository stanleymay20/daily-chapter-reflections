# Optional client-visible Supabase overrides.
# Daily Scripture Companion checks in its public project URL/ref/publishable key
# in src/integrations/supabase/public-config.ts so Lovable builds do not depend
# on a tracked .env file. Set these when targeting a different Supabase project.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>
VITE_SUPABASE_PROJECT_ID=<your-project-ref>

# Optional admin-only Supabase server configuration.
# Normal browser auth and paid-AI quota checks do NOT require service-role access.
# Configure these only for trusted server code that deliberately uses
# src/integrations/supabase/client.server.ts.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<set-only-in-deployment-secrets>

# Server-only provider secrets — never commit real values.
YVP_APP_KEY=<set-in-deployment-secrets>
LOVABLE_API_KEY=<set-in-deployment-secrets>
ELEVENLABS_API_KEY=<optional-set-in-deployment-secrets>
ELEVENLABS_VOICE_ID=<optional-voice-id>
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
